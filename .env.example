# Copy to .env. Every value here is read once at startup and validated; an out-of-range value refuses to start.
# Keys are read only where they are used and are never logged or stored in the ledger.

# ---- mode ----
MODE=paper                          # paper (default) or live; live also needs --live on the command line (see RUNBOOK.md)

# ---- the judge: a typed-question model behind an HTTP API (not a chat LLM), one call per tick. Bring your own provider. ----
JUDGE_BASE_URL=                     # your provider's API origin (https), e.g. https://judge.example; no provider is built in
JUDGE_MODEL=                        # the exact model id to pin; a reply from any other model is discarded and its bill kept
JUDGE_API_KEY=                      # required for any run that judges; sent only to JUDGE_BASE_URL (or an origin listed below)
# JUDGE_KEY_ORIGINS=                # extra origin(s) allowed to receive the key; a loopback literal (127.0.0.1) gets no key; anything else refuses to start
# JUDGE_PRICE_USD_PER_MTOK_INPUT=   # from your vendor's price list; prices are NOT shipped with this repository.
# JUDGE_PRICE_USD_PER_MTOK_OUTPUT=  # without both, every judge call is booked as an UNKNOWN bill (README: Costs);
                                    # leave both unset for that; a blank or malformed value refuses to start; 0 is a zero price

# ---- the slow brain: one call per candidate switch (DeepSeek) ----
DEEPSEEK_API_KEY=                   # required in live, and in paper unless REQUIRE_DEEPSEEK=false
# SLOW_BRAIN_FRAME=forecast        # forecast | regime: the question the slow brain is asked (README: How a decision is made, step 6)
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_MIN_CONFIDENCE=0.6       # 0.5 .. 0.99
# DEEPSEEK_COOLDOWN_MS=300000       # 30000 .. 3600000; candidate ticks inside the cooldown are recorded as deferred
# REQUIRE_DEEPSEEK=true             # paper only may set false (observation without the slow brain)

# ---- paper capital ----
PAPER_CAPITAL_USD=1000              # paper only: the virtual wallet opens with this many dollars in ETH at the tape price (10 .. 100000)
# PAPER_NOTIONAL_CAP_USD=2000       # paper only, needs PAPER_CAPITAL_USD; default 2 x the capital, range 1x .. 10x
# PAPER_CONTINUE_UNKNOWN_BILLING=false   # timed paper sessions only: keep observing after an UNKNOWN bill (the answer is discarded)
# PAPER_UNKNOWN_BILL_RESERVE_USD=0.001   # planning reserve per unknown call, counted against the daily inference budget

# ---- cadence and votes: the risk profile (README: Presets) ----
# RISK_PRESET picks the vote basis and the window; any VOTE_* key below overrides the preset's value.
#   trend       regime basis,   5 of 6   follows the judge's multi-hour regime after five agreeing minutes (default)
#   trend-fast  regime basis,   3 of 4   follows the regime after three agreeing minutes; more switches, more whipsaw cost
#   forecast    forecast basis, 5 of 6   the control: the rule of the first sessions; switches only on a judged 15-minute move beyond cost
RISK_PRESET=trend
TICK_MS=60000                       # one judgment per tick, 2000 .. 300000 ms; the vote window is measured in ticks
# VOTE_BASIS=forecast               # forecast | regime (set by the preset)
# VOTE_WINDOW=6                     # the last N judgments, 2 .. 20 (set by the preset)
# VOTE_MIN=5                        # agreeing judgments needed for a candidate, 1 .. VOTE_WINDOW (set by the preset)
# MIN_DIRECTION_P=0.7               # 0.5 .. 0.99: forecast basis — the vote floor; regime basis — a contrary forecast at or above this vetoes
# MIN_REGIME_P=0.5                  # 0.5 .. 0.99: regime basis — the regime must hold at least this much of the probability mass
# BREAKOUT_MIN_PCT=0                # 0 = off. > 0: a switch needs the price beyond the lookback range's high/low by this many percent (README: Presets)
# BREAKOUT_LOOKBACK_MIN=120         # 60 | 120 | 240: the closed-candle window the breakout condition reads
# VOTE_ACCEPT_QUALITY=good          # forecast basis only: which switch_quality answers may vote: good | good,marginal | good,marginal,bad
# MAX_RISK_OFF_P=0.6                # 0.1 .. 0.9: a judgment above this risk-off probability never votes, on any basis

# ---- hard limits (code, never a model) ----
# MAX_SWITCHES_PER_DAY=6            # 1 .. 24
# MIN_HOLD_MINUTES=20               # 1 .. 1440
# MAX_DAILY_LOSS_PCT=3              # 0.5 .. 10: a daily net loss beyond this halts new actions until --reset-halt
# KILL_LOSS_PCT=30                  # 1 .. 50, must exceed MAX_DAILY_LOSS_PCT: total net loss halt
# INFERENCE_BUDGET_USD_PER_DAY=1    # 0.05 .. 10: judging pauses when the day's judge + slow-brain spend reaches it

# ---- execution ----
# SLIPPAGE_BPS=50                   # 1 .. 300: the tolerance of a live swap
# EXPECTED_SLIPPAGE_BPS=2           # 0 .. 100: what a paper fill assumes below the quote
# PAPER_GAS_USD_PER_LEG=0.003       # 0 .. 1: booked by every paper leg as an external cost
# MIN_NOTIONAL_USD=5                # 1 .. 50
# MAX_GAS_PCT_OF_NOTIONAL=1         # 0.1 .. 5
# GAS_RESERVE_ETH=0.001             # 0.0002 .. 0.01: live only, never swapped
# GAS_LIMIT_MARGIN_PCT=20           # 0 .. 100
# L1_FEE_MARGIN_PCT=25              # 0 .. 200
# SWAP_DEADLINE_SEC=60              # 15 .. 300
# RECEIPT_TIMEOUT_MS=90000          # 15000 .. 600000

# ---- data freshness (event time, not receive time) ----
# CANDLES_REFRESH_MS=60000          # 10000 .. 600000
# MAX_DATA_AGE_SEC=30               # 5 .. 120
# MAX_CANDLE_AGE_SEC=900            # 300 .. 3600
# QUOTE_MAX_AGE_SEC=10              # 3 .. 60
# POSITION_MAX_AGE_SEC=20           # 5 .. 120
# QUOTE_DEADLINE_MS=20000           # 2000 .. 60000: one wall-clock budget for the block read, the quote and the retry waits between them
# RPC_TIMEOUT_MS=8000               # 1000 .. 30000, at most QUOTE_DEADLINE_MS: one RPC attempt
# QUOTE_FAILURE_COOLDOWN_MS=120000  # 10000 .. 3600000, paper only: after a quote failed before any effect, no new candidate for this long

# ---- chain (Base mainnet, chain id 8453) ----
# RPC_URL=https://mainnet.base.org  # https only. A provider URL may carry a key: keep it in this file only; the ledger and the logs
                                    # record the hostname, and error text is sanitized before it is written. The public endpoint is
                                    # rate-limited; parallel paper arms want a keyed one (RUNBOOK)
# ACCOUNT_ADDRESS=                  # your public address: required in live; optional in paper (mirror a real wallet instead of PAPER_CAPITAL_USD)
# PRIVATE_KEY=                      # live only, 0x + 64 hex; must match ACCOUNT_ADDRESS; never commit it
# MAX_CAPITAL_USD=100               # live only: the notional ceiling, 1 .. 100; it can be lowered, never raised

# ---- files ----
# AGENT_DB_PATH=./data/agent.db     # a timed session needs a fresh, unused path (never reuse or move an old ledger)
# AGENT_LOCK_PATH=                  # default data/agent-8453-<account|paper>.lock; give parallel paper sessions their own
